<UserControl
  x:Class="LightBulb.Views.Components.Settings.GeneralSettingsTabView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converters="clr-namespace:LightBulb.Converters"
  xmlns:settings="clr-namespace:LightBulb.ViewModels.Components.Settings"
  x:DataType="settings:GeneralSettingsTabViewModel"
>
  <StackPanel Margin="16" Orientation="Vertical" Spacing="24">
    <!--  Day temperature  -->
    <StackPanel Orientation="Vertical" Spacing="12">
      <Grid
        ColumnDefinitions="*,Auto"
        ToolTip.Tip="{Binding LocalizationManager.DayTemperatureTooltip}"
      >
        <TextBlock
          Grid.Column="0"
          VerticalAlignment="Center"
          Text="{Binding LocalizationManager.DayTemperatureLabel}"
          TextTrimming="CharacterEllipsis"
        />
        <TextBox
          Grid.Column="1"
          MinWidth="24"
          VerticalAlignment="Center"
          Text="{Binding DayTemperature, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
          Theme="{DynamicResource CompactTextBox}"
        />
      </Grid>
      <Slider
        IsSnapToTickEnabled="True"
        LargeChange="500"
        Maximum="{Binding RecommendedMaximumDayTemperature}"
        Minimum="{Binding RecommendedMinimumDayTemperature}"
        SmallChange="100"
        TickFrequency="20"
        Value="{Binding DayTemperature}"
      />
    </StackPanel>

    <!--  Night temperature  -->
    <StackPanel Orientation="Vertical" Spacing="12">
      <Grid
        ColumnDefinitions="*,Auto"
        ToolTip.Tip="{Binding LocalizationManager.NightTemperatureTooltip}"
      >
        <TextBlock
          Grid.Column="0"
          VerticalAlignment="Center"
          Text="{Binding LocalizationManager.NightTemperatureLabel}"
          TextTrimming="CharacterEllipsis"
        />
        <TextBox
          Grid.Column="1"
          MinWidth="24"
          VerticalAlignment="Center"
          Text="{Binding NightTemperature, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
          Theme="{DynamicResource CompactTextBox}"
        />
      </Grid>
      <Slider
        IsSnapToTickEnabled="True"
        LargeChange="500"
        Maximum="{Binding RecommendedMaximumNightTemperature}"
        Minimum="{Binding RecommendedMinimumNightTemperature}"
        SmallChange="100"
        TickFrequency="20"
        Value="{Binding NightTemperature}"
      />
      <TextBlock Text="{Binding LocalizationManager.RedOnlyHelp}" TextWrapping="Wrap" />
    </StackPanel>

    <!--  Day brightness  -->
    <StackPanel Orientation="Vertical" Spacing="12">
      <Grid ColumnDefinitions="*,Auto">
        <ToolTip.Tip>
          <TextBlock
            MaxWidth="350"
            Text="{Binding LocalizationManager.DayBrightnessTooltip}"
            TextWrapping="Wrap"
          />
        </ToolTip.Tip>
        <TextBlock
          Grid.Column="0"
          VerticalAlignment="Center"
          Text="{Binding LocalizationManager.DayBrightnessLabel}"
          TextTrimming="CharacterEllipsis"
        />
        <TextBox
          Grid.Column="1"
          MinWidth="24"
          VerticalAlignment="Center"
          Text="{Binding DayBrightness, Converter={x:Static converters:FractionToPercentageStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
          Theme="{DynamicResource CompactTextBox}"
        />
      </Grid>
      <Slider
        IsSnapToTickEnabled="True"
        LargeChange="0.1"
        Maximum="1"
        Minimum="0.1"
        SmallChange="0.01"
        TickFrequency="0.01"
        Value="{Binding DayBrightness}"
      />
    </StackPanel>

    <!--  Night brightness  -->
    <StackPanel Orientation="Vertical" Spacing="12">
      <Grid ColumnDefinitions="*,Auto">
        <ToolTip.Tip>
          <TextBlock
            MaxWidth="350"
            Text="{Binding LocalizationManager.NightBrightnessTooltip}"
            TextWrapping="Wrap"
          />
        </ToolTip.Tip>
        <TextBlock
          Grid.Column="0"
          VerticalAlignment="Center"
          Text="{Binding LocalizationManager.NightBrightnessLabel}"
          TextTrimming="CharacterEllipsis"
        />
        <TextBox
          Grid.Column="1"
          MinWidth="24"
          VerticalAlignment="Center"
          Text="{Binding NightBrightness, Converter={x:Static converters:FractionToPercentageStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
          Theme="{DynamicResource CompactTextBox}"
        />
      </Grid>
      <Slider
        IsSnapToTickEnabled="True"
        LargeChange="0.1"
        Maximum="1"
        Minimum="0.1"
        SmallChange="0.01"
        TickFrequency="0.01"
        Value="{Binding NightBrightness}"
      />
    </StackPanel>

    <TextBlock IsVisible="{Binding HasScheduleError}" Text="{Binding ScheduleError}" TextWrapping="Wrap" Foreground="OrangeRed" />

    <StackPanel Orientation="Vertical" Spacing="12">
      <TextBlock Text="{Binding LocalizationManager.MorningFadeLabel}" FontWeight="SemiBold" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock
          Grid.Column="0"
          VerticalAlignment="Center"
          Text="{Binding LocalizationManager.FadeDurationLabel}"
          TextTrimming="CharacterEllipsis"
        />
        <TextBox
          Grid.Column="1"
          MinWidth="48"
          VerticalAlignment="Center"
          Text="{Binding MorningDuration, Converter={x:Static converters:TimeSpanToDurationStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
          Theme="{DynamicResource CompactTextBox}"
        />
      </Grid>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock
          VerticalAlignment="Center"
          Text="{Binding LocalizationManager.FadeFinishOffsetLabel}"
        />
        <TextBox
          Grid.Column="1"
          MinWidth="48"
          Text="{Binding MorningFinishOffsetText, UpdateSourceTrigger=LostFocus}"
          Theme="{DynamicResource CompactTextBox}"
        />
      </Grid>
      <TextBlock Text="{Binding MorningScheduleSummary}" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Orientation="Vertical" Spacing="12">
      <TextBlock Text="{Binding LocalizationManager.EveningFadeLabel}" FontWeight="SemiBold" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock
          Grid.Column="0"
          VerticalAlignment="Center"
          Text="{Binding LocalizationManager.FadeDurationLabel}"
          TextTrimming="CharacterEllipsis"
        />
        <TextBox
          Grid.Column="1"
          MinWidth="24"
          VerticalAlignment="Center"
          Text="{Binding EveningDuration, Converter={x:Static converters:TimeSpanToDurationStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
          Theme="{DynamicResource CompactTextBox}"
        />
      </Grid>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock
          VerticalAlignment="Center"
          Text="{Binding LocalizationManager.FadeFinishOffsetLabel}"
        />
        <TextBox
          Grid.Column="1"
          MinWidth="48"
          Text="{Binding EveningFinishOffsetText, UpdateSourceTrigger=LostFocus}"
          Theme="{DynamicResource CompactTextBox}"
        />
      </Grid>
      <TextBlock Text="{Binding EveningScheduleSummary}" TextWrapping="Wrap" />
    </StackPanel>
    <TextBlock Text="{Binding LocalizationManager.FadeOffsetHelp}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
